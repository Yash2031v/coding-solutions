#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    long long a,b,c;
	    cin>>a>>b>>c;
	    float d = a*b;
	    float tp = (c/d)*100;

	    if(tp>50){
	        cout<<"YES"<<endl;
	        
	    }else{
	        cout<<"NO"<<endl;
	    }
	}

}
