#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int x;
        cin>>x;
        int z = x%10;
        if(z==0){
            cout<<x/10<<endl;
        }
        else{
            if(z%5==0){
                cout<<(z/5)+(x/10)<<endl;
            }
            else{
                cout<<-1<<endl;
            }
        }
    }
}
