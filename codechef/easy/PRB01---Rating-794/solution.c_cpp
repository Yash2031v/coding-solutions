#include <bits/stdc++.h>
using namespace std;
void checkprime(int n ){
    if(n==0||n==1){
        cout<<"NO"<<endl;
        return;
    }
    int count=0;
	    for(int i=2;i<n/2;i++){
	        if(n%i==0){
	            count++;
	        }
	    }
	    if(count!=0){
	        cout<<"NO"<<endl;
	    }else{
	            cout<<"Yes"<<endl;
	        }
}
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    checkprime(n);
	    
	}

}
