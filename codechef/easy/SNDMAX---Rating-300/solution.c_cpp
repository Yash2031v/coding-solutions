#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int a,b,c;
        cin>>a>>b>>c;
        int total = a+b+c;
        // cout<<(total-max({a,b,c})-min({a,b,c}))<<end;
        int less = max({a,b,c})+min({a,b,c});
        cout<<total-less<<endl;
        
    }
}
