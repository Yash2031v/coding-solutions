#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int arr[n + 1];

        for (int i = 1; i <= n; i++) {
            cin >> arr[i];
        }

        int sum = 0;
        int count = 0;

        for (int i = 1; i <= n; i++) {
            sum += arr[i];

            if (sum == i) {
                count++;
            }
        }

        cout << count << endl;
    }

    return 0;
}