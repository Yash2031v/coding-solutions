#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int x;
	    cin>>x;
        switch(x%4){
            case 1:
            cout<<"EAST"<<endl;
            break;
            case 2:
            cout<<"SOUTH"<<endl;
            break;
            case 3:
            cout<<"WESt"<<endl;
            break;
            default:
            cout<<"NORTH"<<endl;
        }
	}

}
