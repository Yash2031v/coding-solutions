#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int a1,a2,a3,b1,b2,b3;
	    cin>>a1>>a2>>a3>>b1>>b2>>b3;
	    int a = a1+a2+a3-min({a1,a2,a3});
	    int b = b1+b2+b3-min({b1,b2,b3});
	    if(a>b){
	        cout<<"Alice"<<endl;
	        
	    }else if(a<b){
	        cout<<"Bob"<<endl;
	    }
	    else{
	        cout<<"Tie"<<endl;
	    }
	}

}
