#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin >> n;

    int sum_a = 0, sum_b = 0;
    int max_lead = 0;
    int winner = 0;

    for (int i = 0; i < n; i++) {
        int s, t;
        cin >> s >> t;

        sum_a += s;
        sum_b += t;

        int current_lead = sum_a - sum_b;
        
        if (current_lead > 0) {
            if (current_lead > max_lead) {
                max_lead = current_lead;
                winner = 1;
            }
        } else {
            int lead_b = -current_lead;
            if (lead_b > max_lead) {
                max_lead = lead_b;
                winner = 2;
            }
        }
    }

    cout << winner << " " << max_lead << "\n";

    return 0;
}