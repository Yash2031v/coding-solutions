#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<string>s(n);
	    for(int i=0;i<n;i++){
	        cin>>s[i];
	    }int count=0;
	    for(string x:s){
	        
	        if(x=="START38"){
	            count++;
	        }
	    }cout<<count<<" "<<n-count<<endl;
	}

}
