#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int arr[7];
	    for(int i=0;i<7;i++){
	        cin>>arr[i];
	    }int c=0;int y=0;
	    for(int x:arr){
	        if(x==1){
	            c++;
	        }
	        else{
	            y++;
	        }
	    }
	    if(c>y){
	        cout<<"YES"<<endl;
	    }
	    else{
	        cout<<"NO"<<endl;
	    }
	}

}
