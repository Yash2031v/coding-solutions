#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int arr[n];
	    for(int i = 0;i<n;i++){
	        cin>>arr[i];
	    }
	    int r = 0;
	    for(int i = 0;i<n;i++){
	        if(arr[i]<=arr[i+1]){
	            r = arr[i]+arr[i+1];
	        }
	    }
	    cout<<r<<endl;
	}

}
