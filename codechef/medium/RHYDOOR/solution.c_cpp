#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    string s;
	    cin>>s;
	    int count = 0;
	    int gcount=0;
	    char prev = ' ';
	    for(int i = 0; i < n; i++) {
            if (s[i] == prev) {
                count++;
            } else {
                prev = s[i];
                count = 1;
            }

            if (count == 3) {
                gcount++;
                count = 0;
            }
        }
	    cout<<gcount<<endl;
	}

}
