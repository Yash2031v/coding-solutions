#include <iostream>
using namespace std;

void solve() {
    int N, M;
    cin >> N >> M;
    if (N % 2 == 0 || M % 2 == 0) {
        cout << "Yes\n";
    } else {
        cout << "No\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int T;
    cin >> T;
    while (T--) {
        solve();
    }
    return 0;
}