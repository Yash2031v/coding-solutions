void solve() {
    int n, m;
    cin >> n >> m;

    vector<string> grid(n, string(m, '.'));
    vector<pair<int, int>> rooks;

    auto attacks_count = [&](int r, int c) {
        int atk = 0;
        for (int j = c - 1; j >= 0; --j) {
            if (grid[r][j] == 'R') { ++atk; break; }
        }
        for (int j = c + 1; j < m; ++j) {
            if (grid[r][j] == 'R') { ++atk; break; }
        }
        for (int i = r - 1; i >= 0; --i) {
            if (grid[i][c] == 'R') { ++atk; break; }
        }
        for (int i = r + 1; i < n; ++i) {
            if (grid[i][c] == 'R') { ++atk; break; }
        }
        return atk;
    };

    auto valid_all = [&]() {
        for (const auto& p : rooks) {
            if (attacks_count(p.first, p.second) > 1) return false;
        }
        return true;
    };

    auto try_pair = [&](int r1, int c1, int r2, int c2) {
        if (r2 >= n || c2 >= m) return;
        if (grid[r1][c1] == 'R' || grid[r2][c2] == 'R') return;

        grid[r1][c1] = 'R';
        grid[r2][c2] = 'R';
        rooks.push_back({r1, c1});
        rooks.push_back({r2, c2});

        if (!valid_all()) {
            rooks.pop_back();
            rooks.pop_back();
            grid[r1][c1] = '.';
            grid[r2][c2] = '.';
        }
    };

    // Place horizontal and vertical pairs cleanly
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < m; ++j) {
            try_pair(i, j, i, j + 1);
            try_pair(i, j, i + 1, j);
        }
    }

    // Fallback: add any isolated rook that still keeps attacks <= 1
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < m; ++j) {
            if (grid[i][j] == '.') {
                grid[i][j] = 'R';
                rooks.push_back({i, j});
                if (!valid_all()) {
                    rooks.pop_back();
                    grid[i][j] = '.';
                }
            }
        }
    }

    cout << rooks.size() << '\n';
    for (const auto& row : grid) {
        cout << row << '\n';
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}