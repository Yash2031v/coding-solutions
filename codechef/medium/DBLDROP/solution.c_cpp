#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;

    vector<long long> a(n);
    long long total_sum = 0;
    long long max_val = 0;

    for (int i = 0; i < n; ++i) {
        cin >> a[i];
        total_sum += a[i];
        max_val = max(max_val, a[i]);
    }

    // Option 0: perform no operation
    long long ans = total_sum - max_val;

    // Option 1: double a[i] for some index i
    for (int i = 0; i < n; ++i) {
        long long new_sum = total_sum + a[i];
        long long new_max = max(max_val, 2LL * a[i]);
        ans = max(ans, new_sum - new_max);
    }

    cout << ans << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}