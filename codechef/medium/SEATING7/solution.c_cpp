#include <iostream>
#include <vector>

using namespace std;

void solve() {
    int N, M, K;
    cin >> N >> M >> K;

    vector<bool> occupied(N + 1, false);

    for (int i = 0; i < M; ++i) {
        int a;
        cin >> a;
        occupied[a] = true;
    }

    vector<int> assigned_seats;
    int current_seat = 1;

    for (int person = 0; person < K; ++person) {
        while (current_seat <= N && occupied[current_seat]) {
            current_seat++;
        }
        assigned_seats.push_back(current_seat);
        occupied[current_seat] = true;
    }

    for (int i = 0; i < K; ++i) {
        cout << assigned_seats[i] << (i == K - 1 ? "" : " ");
    }
    cout << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int T;
    cin >> T;
    while (T--) {
        solve();
    }

    return 0;
}