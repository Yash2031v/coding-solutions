#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        long long sum = 0;
        long long mn = 1e18;

        for (int i = 0; i < N; i++) {
            long long x;
            cin >> x;

            sum += x;
            mn = min(mn, x);
        }

        long long ans = sum + (N - 2) * mn;

        cout << ans << endl;
    }

    return 0;
}