#include <bits/stdc++.h>
using namespace std;
int step(int n){
    if(n<0){
        return 0;
    }
    if(n==0){
        return 1;
    }
    return step(n-2) + step(n-1);
}
int main() {
	int T;
	cin>>T;
	while(T--){
	    int N,K;
	    cin>>N;
	    cin>>K;
	    
	    if (step(N) > K && K <= N) {
            cout << "YES\n";
        } 
        else {
            cout << "NO\n";
        }
	}

}
