
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        string s;
        cin >> s;

        int ans = 0;
        int i = 0;

        while (i < n) {
            if (s[i] == '1') {
                ans++;
                i++;
                int start = max(0, i - k - 1);

                while (i < n && i <= start + k && s[i] == '0') {
                    i++;
                }
            } else {
                i++;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
