#include <iostream>
#include <string>

using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;
    string s;
    cin >> s;

    int alarms = 0;
    for (int i = 0; i < n; ) {
        if (s[i] == '1') {
            alarms++;
            i += k + 1; // Protected up to i + k, next room to check is i + k + 1
        } else {
            i++;
        }
    }
    cout << alarms << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}