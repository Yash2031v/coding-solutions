
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        string S;
        cin >> S;

        int ans = 0;

        for (int i = 0; i < N; i++) {
            int num = (S[i] - '0') * 10 +
                      (S[(i + 1) % N] - '0');

            if (num % 4 == 0) {
                ans++;
            }
        }

        cout << ans << endl;
    }

    return 0;
}
