
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, D;
        cin >> N >> D;

        int A[N], B[N];

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        for (int i = 0; i < N; i++) {
            cin >> B[i];
        }

        int cost1 = D;
        int cost2 = D;
        int cost3 = 2 * D;

        for (int i = 0; i < N; i++) {
            cost1 += A[i];
            cost2 += B[i];
            cost3 += min(A[i], B[i]);
        }

        cout << min({cost1, cost2, cost3}) << endl;
    }

    return 0;
}
