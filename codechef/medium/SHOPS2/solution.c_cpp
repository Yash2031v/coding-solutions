#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int N;
	cin>>N;
	while(N--){
	    int N;
	    int D;
	    cin>>N;
	    int A[N];
	    int B[N];
	    for(int i=0; i<N; i++){
	        cin>>A[i];
	    }
	    for(int i=0; i<N; i++){
	        cin>>B[i];
	    }
	    for(int i=0; i<N;i++){
	        cost1 = D + sum(A[i])
	        cost2 = D + sum(B[i])
            cost3 = 2*D + sum(min(A[i], B[i]))
	    }
	    cout<<min(cost1,cost2,cost3)<<endl;
	    
	}

}
